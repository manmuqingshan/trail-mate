{
  "name": "platform_wio_tracker_l2",
  "version": "0.1.0",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "build": {
    "includeDir": "include",
    "srcDir": "src",
    "flags": [
      "-std=gnu++17",
      "-I../../../platform/shared/include",
      "-I../../../platform/esp/boards/include",
      "-I../../../platform/esp/arduino_common/include",
      "-I../../../modules/core_sys/include",
      "-I../../../modules/core_gps/include",
      "-I../../../modules/core_chat/include",
      "-I../../../modules/ui_shared/include",
      "-I../../../boards/wio_tracker_l2/include"
    ]
  },
  "dependencies": [
    {"name": "boards_wio_tracker_l2"},
    {"name": "RadioLib"},
    {"name": "TinyGPSPlus"},
    {"name": "LovyanGFX"},
    {"name": "audio-driver"},
    {"name": "trail_mate_codec2"},
    {"name": "core_sys"}
  ]
}
