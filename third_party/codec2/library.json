{
  "name": "trail_mate_codec2",
  "version": "1.0.7",
  "description": "Vendored Codec2 dependency for Trail Mate ESP platforms.",
  "frameworks": [
    "arduino"
  ],
  "build": {
    "includeDir": "src",
    "srcDir": "src",
    "srcFilter": [
      "-<*>",
      "+<codebook.c>",
      "+<codebookd.c>",
      "+<codebookge.c>",
      "+<codebookjmv.c>",
      "+<codebooknewamp1.c>",
      "+<codebooknewamp1_energy.c>",
      "+<codebooknewamp2.c>",
      "+<codebooknewamp2_energy.c>",
      "+<codec2.c>",
      "+<codec2_fft.c>",
      "+<interp.c>",
      "+<kiss_fft.c>",
      "+<kiss_fftr.c>",
      "+<lpc.c>",
      "+<lsp.c>",
      "+<mbest.c>",
      "+<memtools.c>",
      "+<newamp1.c>",
      "+<newamp2.c>",
      "+<nlp.c>",
      "+<pack.c>",
      "+<phase.c>",
      "+<postfilter.c>",
      "+<quantise.c>",
      "+<sine.c>"
